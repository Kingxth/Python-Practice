# Entorno virtual de Python
venv/
ENV/
env/

# Archivos de caché de Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Archivos de distribución / paquetes
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Base de datos local o SQLite (por si llegas a usarla)
*.sqlite3
*.db

# Carpeta de uploads (ignora los archivos que suban los usuarios, pero mantiene la carpeta si usas .gitkeep)
uploads/*
!uploads/.gitkeep

# IDEs y editores (VS Code, PyCharm, etc.)
.vscode/
.idea/
*.swp
*.swo

# Sistema operativo
.DS_Store
Thumbs.db
